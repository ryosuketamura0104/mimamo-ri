# アプリケーション
APP_URL=http://localhost:3000
NODE_ENV=development

# データベース
DATABASE_URL=postgresql://mimamori:mimamori@localhost:5432/mimamori
POSTGRES_USER=mimamori
POSTGRES_PASSWORD=mimamori
POSTGRES_DB=mimamori
POSTGRES_PORT=5432

# Firebase Admin（IDトークン検証 + FCM 送信）
# サービスアカウント JSON をそのまま貼る
FIREBASE_SERVICE_ACCOUNT_KEY=

# APNs（iOS プッシュ、token-based）
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.crouton.mimamori
# .p8 の内容そのまま（改行含む）
APNS_PRIVATE_KEY=
# production or development
APNS_ENV=development

# 内部 cron トークン（/internal/cron/* の Bearer 認証）
INTERNAL_CRON_TOKEN=

# 天気データソース（未確定。仮に OpenWeather を想定）
OPENWEATHER_API_KEY=

# RevenueCat Webhook 検証用の Bearer トークン
REVENUECAT_WEBHOOK_SECRET=

# 見守る側の無料枠(ペアリング人数)。超えるとサブスク要求
WATCHER_FREE_PAIR_LIMIT=1

# Firebase Web SDK（クライアント公開値）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
